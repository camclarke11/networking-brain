{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard.schema.json",
  "title": "Storyboard for one reel (version 2: creative direction)",
  "description": "Shots grouped by idea, each covering one or more consecutive script lines. Timing comes later from the recorded audio via tools/align.py, so nothing here is in seconds. Rules: knowledge/12-visual-storyboard.md. Checked by tools/check_script.py.",
  "type": "object",
  "required": [
    "version",
    "concept",
    "names",
    "shots",
    "new_assets"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "concept": {
      "type": "object",
      "required": [
        "metaphor",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "metaphor": {
          "type": "string",
          "description": "The one visual idea that runs through the video."
        },
        "why": {
          "type": "string",
          "description": "How the picture makes the lesson clearer."
        },
        "library_metaphor": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Library id if this reuses a recurring metaphor."
        }
      }
    },
    "names": {
      "type": "object",
      "description": "Display names used in this script, by cast id.",
      "propertyNames": {
        "enum": [
          "you",
          "connector",
          "big_name",
          "friend",
          "stranger_a",
          "stranger_b",
          "stranger_c",
          "professor",
          "crowd"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "new_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": [
        "id",
        "lines",
        "what_we_see",
        "camera",
        "cast",
        "uses",
        "new",
        "on_screen"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[first, last] script line this shot covers, inclusive."
        },
        "title": {
          "type": "string"
        },
        "what_we_see": {
          "type": "string",
          "description": "Plain words: what happens on screen, with enough detail to build it."
        },
        "camera": {
          "type": "string",
          "description": "Free text: framing and movement."
        },
        "transition_in": {
          "type": "string",
          "description": "Free text, e.g. cut, whip pan, match cut on the door."
        },
        "cast": {
          "type": "array",
          "items": {
            "enum": [
              "you",
              "connector",
              "big_name",
              "friend",
              "stranger_a",
              "stranger_b",
              "stranger_c",
              "professor",
              "crowd"
            ]
          },
          "description": "Cast on screen."
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": "Library ids reused in this shot (visuals/library.json)."
        },
        "new": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": "New asset ids first made for this video, each described in new_assets."
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "word",
              "what"
            ],
            "additionalProperties": false,
            "properties": {
              "word": {
                "type": "string",
                "description": "A word spoken in this shot's lines."
              },
              "line": {
                "type": "integer",
                "description": "Optional: which line, if the word appears more than once."
              },
              "what": {
                "type": "string"
              }
            }
          }
        },
        "on_screen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "sound": {
          "type": "string",
          "description": "Optional sound effect or music note."
        },
        "screenshot": {
          "type": "boolean",
          "description": "True on the frame people would pause on or send."
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "description",
        "reuse"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "kind": {
          "enum": [
            "set",
            "prop",
            "effect",
            "costume",
            "metaphor"
          ]
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Shape, material, size next to a character, how it moves."
        },
        "reuse": {
          "type": "string",
          "description": "What else it could be used for."
        }
      }
    },
    "component": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "big_text"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "speaker",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "quote_bubble"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "speaker": {
              "enum": [
                "you",
                "connector",
                "big_name",
                "friend",
                "stranger_a",
                "stranger_b",
                "stranger_c",
                "professor",
                "crowd"
              ]
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "wrong",
            "right"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "x_check"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "wrong": {
              "type": "string"
            },
            "right": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "title",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "tool_card"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "title": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "highlight": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "year",
            "who",
            "finding"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "study_card"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "year": {
              "type": "integer"
            },
            "who": {
              "type": "string"
            },
            "finding": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "from",
            "messages"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "dm_screen"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "from": {
              "type": "string"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "side",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "side": {
                    "enum": [
                      "me",
                      "them"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text",
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "label"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "text": {
              "type": "string"
            },
            "target": {
              "enum": [
                "you",
                "connector",
                "big_name",
                "friend",
                "stranger_a",
                "stranger_b",
                "stranger_c",
                "professor",
                "crowd"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "stamp"
            },
            "at": {
              "type": "string",
              "description": "Optional spoken word (in this shot's lines) the component appears on."
            },
            "text": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
